{
  "title": "Memory pressure",
  "uid": "memory-pressure",
  "description": "Real memory use and pressure of the k3s nodes and VMs, and of the containers on them. kubernetes-infrastructure 7-monitoring.",
  "tags": [
    "homelab",
    "memory"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Container restarts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "sum by (namespace, pod, container) (changes(kube_pod_container_status_restarts_total[2m])) > 0",
        "step": "1m",
        "titleFormat": "Restart",
        "textFormat": "{{namespace}}/{{pod}} {{container}}",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Hosts (node exporter: k3s nodes and VMs)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory used (without cache)",
      "description": "1 - MemAvailable / MemTotal. What is really in use: reclaimable page cache does not count, unlike Proxmox's view of a VM.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=~\".*node-exporter|node-vms\"} / node_memory_MemTotal_bytes{job=~\".*node-exporter|node-vms\"}) * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"}",
          "legendFormat": "{{nodename}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory available",
      "description": "MemAvailable: what programs can still get, including cache the kernel can drop.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=~\".*node-exporter|node-vms\"} * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"}",
          "legendFormat": "{{nodename}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory stall (PSI)",
      "description": "Share of time tasks waited for memory. some = at least one task, full = all tasks at once. Anything above a few % means real pressure: the kernel is reclaiming or swapping in instead of running work.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "100 * rate(node_pressure_memory_waiting_seconds_total{job=~\".*node-exporter|node-vms\"}[$__rate_interval]) * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"}",
          "legendFormat": "{{nodename}} some"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "100 * rate(node_pressure_memory_stalled_seconds_total{job=~\".*node-exporter|node-vms\"}[$__rate_interval]) * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"}",
          "legendFormat": "{{nodename}} full"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Page cache + buffers",
      "description": "Cached + Buffers. Falling toward 0 while used climbs = the kernel is evicting file cache to make room; programs then reread their files from disk and everything slows down.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "(node_memory_Cached_bytes{job=~\".*node-exporter|node-vms\"} + node_memory_Buffers_bytes{job=~\".*node-exporter|node-vms\"}) * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"}",
          "legendFormat": "{{nodename}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Major page faults",
      "description": "Pages read back from disk per second. Spikes together with low cache = thrashing.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "rate(node_vmstat_pgmajfault{job=~\".*node-exporter|node-vms\"}[$__rate_interval]) * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"}",
          "legendFormat": "{{nodename}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Visible RAM (balloon)",
      "description": "MemTotal as the guest sees it. Drops when Proxmox inflates the balloon because its node is over 80% RAM (memory_min in homelab-infrastructure).",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": null
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{job=~\".*node-exporter|node-vms\"} * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"}",
          "legendFormat": "{{nodename}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OOM kills",
      "description": "Processes killed by the kernel OOM killer (whole host, any cgroup).",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "increase(node_vmstat_oom_kill{job=~\".*node-exporter|node-vms\"}[$__rate_interval]) * on(instance) group_left(nodename) node_uname_info{job=~\".*node-exporter|node-vms\"} > 0",
          "legendFormat": "{{nodename}}",
          "interval": "1m"
        }
      ]
    },
    {
      "type": "row",
      "title": "Containers (Kubernetes)",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Grafana and Prometheus vs limit",
      "description": "Working set (what the OOM killer counts) against the memory limit (dashed).",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (pod, container) (container_memory_working_set_bytes{namespace=\"monitoring\", container=~\"grafana|prometheus\", image!=\"\"})",
          "legendFormat": "{{container}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max by (container) (kube_pod_container_resource_limits{namespace=\"monitoring\", container=~\"grafana|prometheus\", resource=\"memory\"})",
          "legendFormat": "{{container}} limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Closest to their limit",
      "description": "Top 10 containers by working set as % of their memory limit. At 100% the container is OOMKilled.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk(10, max by (namespace, pod, container) (container_memory_working_set_bytes{container!=\"\", image!=\"\"}) / on(namespace, pod, container) max by (namespace, pod, container) (kube_pod_container_resource_limits{resource=\"memory\"}) * 100)",
          "legendFormat": "{{namespace}}/{{container}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top 10 containers by memory",
      "description": "Working set per container, per node. Shows who fills a node.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk(10, max by (node, namespace, pod, container) (container_memory_working_set_bytes{container!=\"\", image!=\"\"}) * on(namespace, pod) group_left(node) max by (namespace, pod, node) (kube_pod_info))",
          "legendFormat": "{{node}} {{namespace}}/{{container}}"
        }
      ]
    }
  ]
}
